# Modo demo: datos dummy en memoria, sin Firebase ni Apps Script.
# Por defecto ON. Pon "false" para usar los servicios reales (Vercel).
NEXT_PUBLIC_DEMO_MODE=true

# Ruta base si se despliega bajo una subcarpeta (GitHub Pages: /jam-session).
# Déjalo vacío en Vercel (dominio raíz).
NEXT_PUBLIC_BASE_PATH=

# Firebase (cliente) — Firebase Console → Configuración del proyecto → Tus apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Apps Script (solo servidor) — ver apps-script/README.md
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=

# firebase-admin (solo servidor) — JSON de la cuenta de servicio, en base64:
#   [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes((Get-Content service.json -Raw))
# o pega el JSON directamente en una línea.
FIREBASE_SERVICE_ACCOUNT=
