# Modo demo: datos dummy en memoria, sin Firebase ni Apps Script.
# Por defecto ON. Pon "false" para usar los servicios reales.
# En GitHub Pages: Settings → Secrets and variables → Actions → Variables
# (o Secrets) → NEXT_PUBLIC_DEMO_MODE = false
NEXT_PUBLIC_DEMO_MODE=true

# Ruta base si se despliega bajo una subcarpeta (GitHub Pages: /jam-session).
# Déjalo vacío en dominio raíz (satisol-develop.github.io).
NEXT_PUBLIC_BASE_PATH=

# Firebase (cliente) — Firebase Console → Configuración del proyecto → Tus apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Apps Script (Web App URL — el navegador lo llama directamente)
# Ver apps-script/README.md; en local puedes usar `webAppUrl()` en el editor.
NEXT_PUBLIC_APPS_SCRIPT_URL=
# (el codigo del backend Apps Script vive en apps-script/, local y fuera del repo)
